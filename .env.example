# Copy to .env and replace demo credentials before sharing any deployment.
INTERNAL_API_TOKEN=local-dev-token-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deployment
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAIL_FROM=demo@example.com
FOLLOWUP_DELAY_HOURS=48
# Docker Compose supplies DATABASE_URL, N8N_WEBHOOK_URL and SMTP_HOST internally.
# Running Python locally? Keep SMTP_HOST empty to inspect the local outbox.
